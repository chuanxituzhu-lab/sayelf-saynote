.page-shell {
  min-height: 100vh;
  padding: 28rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.page-heading,
.section-heading,
.capture-heading,
.capture-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-heading {
  align-items: flex-start;
  margin: 18rpx 0 34rpx;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #9a8f7e;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-title {
  color: #25231f;
  font-family: Georgia, serif;
  font-size: 76rpx;
  font-weight: 500;
  letter-spacing: -4rpx;
}

.date-chip {
  margin-top: 12rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #e2ddd1;
  border-radius: 999rpx;
  color: #817869;
  font-size: 23rpx;
}

.capture-card {
  padding: 34rpx;
  border: 1rpx solid #e4ded2;
  border-radius: 32rpx;
  background: #fffdf9;
  box-shadow: 0 18rpx 54rpx rgba(91, 75, 53, 0.07);
}

.capture-heading {
  justify-content: flex-start;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.capture-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d9795c;
  box-shadow: 0 0 0 10rpx #f8e6df;
}

.card-title,
.section-title {
  color: #25231f;
  font-family: Georgia, serif;
  font-size: 38rpx;
  font-weight: 500;
}

.record-input {
  width: 100%;
  min-height: 200rpx;
  color: #25231f;
  font-size: 30rpx;
  line-height: 1.65;
}

.record-input-placeholder {
  color: #b7aea2;
}

.capture-actions {
  gap: 20rpx;
  margin-top: 20rpx;
}

.capture-hint,
.local-note {
  color: #aaa093;
  font-size: 21rpx;
}

.save-button {
  min-width: 112rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 20rpx;
  color: #c4bdb3;
  background: #e7e1d8;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.save-button-active {
  color: #fffaf4;
  background: #2d2a25;
}

.timeline-section {
  margin-top: 52rpx;
}

.section-heading {
  margin-bottom: 22rpx;
}

.record-count {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #8e8374;
  background: #e9e3d8;
  font-size: 23rpx;
}

.status-muted,
.status-error {
  padding: 24rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.status-muted {
  color: #9b9185;
}

.status-error {
  color: #b45c47;
}

.empty-state {
  padding: 48rpx 24rpx;
  border: 1rpx dashed #d9d0c3;
  border-radius: 24rpx;
  color: #9f9588;
  text-align: center;
}

.empty-mark {
  margin-bottom: 16rpx;
  color: #d9795c;
  font-size: 34rpx;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #6f665b;
  font-size: 28rpx;
}

.empty-hint {
  font-size: 23rpx;
}

.record-item {
  display: flex;
  gap: 24rpx;
  padding: 26rpx 4rpx;
  border-top: 1rpx solid #e6dfd4;
}

.record-time {
  width: 80rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
  color: #a69a8c;
  font-size: 22rpx;
}

.record-body {
  min-width: 0;
  flex: 1;
}

.record-kind {
  color: #b2a797;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.record-text {
  margin-top: 10rpx;
  color: #39342e;
  font-size: 29rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.local-note {
  margin-top: 40rpx;
  padding: 22rpx 0;
  text-align: center;
}
